<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SmartJam.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="980"
        d:DesignHeight="760"
        x:Class="SmartJam.Views.MainWindow"
        x:DataType="views:MainWindow"
        Title="SmartJam"
        Width="1120"
        MinWidth="860"
        Height="820"
        MinHeight="640"
        Background="#F3F6FB"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#1F2A44"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6F98"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#D8E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#3857C6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12 9"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#F6F8FD"/>
            <Setter Property="Foreground" Value="#42557D"/>
            <Setter Property="BorderBrush" Value="#CCD7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#A93745"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2A44"/>
            <Setter Property="BorderBrush" Value="#CCD7EB"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="DataValidationErrors.ErrorTemplate" Value="{x:Null}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2A44"/>
            <Setter Property="BorderBrush" Value="#CCD7EB"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="DataValidationErrors.ErrorTemplate" Value="{x:Null}"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#6E8DFF"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#E5EBF7"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#F8FAFF"/>
            <Setter Property="BorderBrush" Value="#D8E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20">
        <Border Grid.Row="0" Margin="0 0 0 14" Background="#FFFFFF" CornerRadius="12" Padding="16 12"
                BorderBrush="#D8E1F0" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="SMARTJAM" FontSize="18" FontWeight="Bold" Foreground="#1F2A44"/>
                    <TextBlock Text="Détection de note en temps réel" Foreground="#6E82A8" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Command="{Binding OpenSettingsCommand}" Content="Audio Settings"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="300,*" ColumnSpacing="14" Margin="0 0 0 8">
                <StackPanel Grid.Column="0" Spacing="14">
                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-title" Text="MONITORING"/>
                            <TextBlock Text="Notation" Foreground="#6E82A8"/>
                            <ComboBox ItemsSource="{Binding NotationModes}" SelectedItem="{Binding SelectedNotation}"/>
                            <TextBlock Text="Mode" Foreground="#6E82A8"/>
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"/>
                            <Button Command="{Binding ToggleMonitoringCommand}"
                                    Content="{Binding MonitoringButtonText}"
                                    Classes.danger="{Binding IsMonitoring}"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0 4 0 0">
                                <TextBlock Text="RMS" Foreground="#6E82A8"/>
                                <TextBlock Grid.Column="1" Text="{Binding InputLevelDb}" Foreground="#5A6F98" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding InputLevel}" Foreground="{Binding RmsMeterColor}"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Text="Peak" Foreground="#6E82A8"/>
                                <TextBlock Grid.Column="1" Text="{Binding PeakLevelDb}" Foreground="#5A6F98" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding PeakLevel}" Foreground="{Binding PeakMeterColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" IsVisible="{Binding IsOscillatorPanelVisible}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-title" Text="OSCILLATOR"/>
                            <TextBlock Text="Frequency (Hz)" Foreground="#6E82A8"/>
                            <NumericUpDown x:Name="OscFrequencyInput"
                                           Value="{Binding OscFrequency}"
                                           Minimum="20"
                                           Maximum="4000"
                                           Increment="1"
                                           FormatString="F0"/>
                            <Border Background="#EEF3FD"
                                    BorderBrush="#D4DFF3"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8 6"
                                    Cursor="SizeNorthSouth"
                                    PointerPressed="OnOscFrequencyPointerPressed"
                                    PointerMoved="OnOscFrequencyPointerMoved"
                                    PointerReleased="OnOscFrequencyPointerReleased"
                                    PointerCaptureLost="OnOscFrequencyPointerCaptureLost">
                                <TextBlock Text="Glisser haut/bas pour changer la fréquence (Shift = plus rapide)"
                                           FontSize="11"
                                           Foreground="#5A6F98"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Amplitude" Foreground="#6E82A8"/>
                            <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding OscAmplitude}"/>
                            <TextBlock Text="{Binding OscAmplitude, StringFormat={}{0:F2}}" Foreground="#5A6F98"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="760">
                    <Border Width="320" Height="320" CornerRadius="160" Background="#FFFFFF"
                            BorderBrush="#C6D3EA" BorderThickness="2" Padding="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="{Binding DetectedNote}" FontSize="84" FontWeight="Bold" Foreground="#2C3E66" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DetectedFrequency}" FontSize="24" Foreground="#6B82AF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Width="420" MaxWidth="720">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section-title" Text="NOTES JOUÉES" Margin="0"/>
                                <Button Grid.Column="1" Classes="secondary" Content="Reset notes jouées" Command="{Binding ResetPlayedNotesCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PlayedNotes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF3FD" BorderBrush="#D4DFF3" BorderThickness="1"
                                                CornerRadius="6" Padding="9 5" Margin="3 3">
                                            <TextBlock Text="{Binding}" Foreground="#3A4F77" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Width="420" MaxWidth="720">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-title" Text="ANALYSE"/>
                            <TextBlock Text="Tonalité probable" Foreground="#6E82A8"/>
                            <TextBlock Text="{Binding PossibleKey}" FontSize="26" FontWeight="SemiBold" Foreground="#2C3E66"/>

                            <TextBlock Text="Accord probable" Foreground="#6E82A8" Margin="0 10 0 0"/>
                            <TextBlock Text="{Binding PossibleChord}" FontSize="26" FontWeight="SemiBold" Foreground="#2C3E66"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Width="520" MaxWidth="720" MinHeight="360">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 6">
                                <TextBlock Classes="section-title" Text="JOURNAL" Margin="0"/>
                                <Button Grid.Column="1" Classes="secondary" Content="Copier" Command="{Binding CopyLogsCommand}"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding LogMessages}" Height="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</Window>

