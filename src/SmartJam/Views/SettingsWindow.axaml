<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartJam.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SmartJam.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Audio Settings"
        Width="480" MinWidth="400"
        Height="500" MinHeight="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E">

    <!-- ── Styles ─────────────────────────────────────────────────────────── -->
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Inter,Segoe UI,sans-serif"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#7A8299"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin"     Value="0 0 0 4"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground"  Value="#6E8EFA"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0 0 0 10"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"   Value="#252535"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="16 14"/>
            <Setter Property="Margin"       Value="0 0 0 10"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background"       Value="#2E2E42"/>
            <Setter Property="Foreground"       Value="#CDD6F4"/>
            <Setter Property="BorderBrush"      Value="#3D3D55"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily"   Value="Inter,Segoe UI,sans-serif"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding"      Value="14 9"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6E8EFA"/>
            <Setter Property="Foreground" Value="#0F0F1A"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2E2E42"/>
            <Setter Property="Foreground" Value="#A0A8C0"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6E8EFA"/>
            <Setter Property="Padding"    Value="6 6"/>
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="#A6E3A1"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#141422" Padding="20 14">
            <StackPanel Spacing="2">
                <TextBlock Text="AUDIO SETTINGS"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#6E8EFA"
                           LetterSpacing="2"/>
                <TextBlock Text="Driver, périphériques, sample rate et buffer"
                           FontSize="11" Foreground="#4A4A6A"/>
            </StackPanel>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#141422" Padding="20 12">
            <Grid ColumnDefinitions="*, Auto, 8, Auto">
                <TextBlock Grid.Column="0"
                           Classes="status"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="secondary"
                        Content="Annuler"
                        Click="OnCancelClick"/>
                <Button Grid.Column="3"
                        Classes="primary"
                        Content="Appliquer"
                        Command="{Binding ApplyCommand}"
                        Click="OnApplyClick"/>
            </Grid>
        </Border>

        <!-- ── Content ─────────────────────────────────────────────────────── -->
        <ScrollViewer Padding="20 14">
            <StackPanel Spacing="0">

                <!-- ── Audio Driver ──────────────────────────────────────── -->
                <Border Classes="card">
                    <StackPanel Spacing="0">
                        <TextBlock Classes="section" Text="AUDIO DRIVER"/>
                        <TextBlock Classes="label"   Text="Driver"/>
                        <ComboBox ItemsSource="{Binding AudioDrivers}"
                                  SelectedItem="{Binding SelectedAudioDriver}"/>
                    </StackPanel>
                </Border>

                <!-- ── WASAPI Devices (visible seulement si WASAPI) ──────── -->
                <Border Classes="card" IsVisible="{Binding IsWasapiSelected}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="PÉRIPHÉRIQUES WASAPI"/>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Entrée (Input Device)"/>
                            <Grid ColumnDefinitions="*, 8, Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding InputDevices}"
                                          SelectedItem="{Binding SelectedInputDevice}"/>
                                <Button Grid.Column="2"
                                        Classes="ghost"
                                        Content="&#8635;"
                                        FontSize="16"
                                        Command="{Binding RefreshDevicesCommand}"
                                        ToolTip.Tip="Rafraîchir la liste"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Sortie (Output Device)"/>
                            <ComboBox ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ASIO Driver (visible seulement si ASIO) ───────────── -->
                <Border Classes="card" IsVisible="{Binding IsAsioSelected}">
                    <StackPanel Spacing="0">
                        <TextBlock Classes="section" Text="ASIO DRIVER"/>
                        <Grid ColumnDefinitions="*, 8, Auto">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AsioDrivers}"
                                      SelectedItem="{Binding SelectedAsioDriver}"/>
                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Content="&#8635;"
                                    FontSize="16"
                                    Command="{Binding RefreshDevicesCommand}"
                                    ToolTip.Tip="Rafraîchir la liste"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Sample Rate + Buffer Size ─────────────────────────── -->
                <Border Classes="card">
                    <StackPanel Spacing="0">
                        <TextBlock Classes="section" Text="FORMAT AUDIO"/>
                        <Grid ColumnDefinitions="*, 16, *">

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="label" Text="Sample Rate (Hz)"/>
                                <ComboBox ItemsSource="{Binding SampleRates}"
                                          SelectedItem="{Binding SelectedSampleRate}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="label" Text="Buffer Size (samples)"/>
                                <ComboBox ItemsSource="{Binding BufferSizes}"
                                          SelectedItem="{Binding SelectedBufferSize}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
