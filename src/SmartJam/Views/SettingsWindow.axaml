<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartJam.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SmartJam.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Audio Settings"
        Width="560" MinWidth="480"
        Height="680" MinHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Inter,Segoe UI,sans-serif">

    <!-- ── Styles ─────────────────────────────────────────────────────────── -->
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontFamily" Value="Inter,Segoe UI,sans-serif"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground"    Value="#64748B"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="FontWeight"    Value="Medium"/>
            <Setter Property="Margin"        Value="0 0 0 6"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground"    Value="#6366F1"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Margin"        Value="0 0 0 12"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="20 16"/>
            <Setter Property="Margin"          Value="0 0 0 10"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow"       Value="0 1 3 0 #10000000"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background"          Value="#FFFFFF"/>
            <Setter Property="Foreground"          Value="#1E293B"/>
            <Setter Property="BorderBrush"         Value="#CBD5E1"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="8"/>
            <Setter Property="Height"              Value="40"/>
            <Setter Property="FontSize"            Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="DataValidationErrors.ErrorTemplate" Value="{x:Null}"/>
		</Style>
        <Style Selector="Button">
            <Setter Property="FontFamily"   Value="Inter,Segoe UI,sans-serif"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding"      Value="16 10"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6366F1"/>
            <Setter Property="Padding"    Value="6 6"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
			<Setter Property="DataValidationErrors.ErrorTemplate" Value="{x:Null}"/>
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="24 16"
                BorderBrush="#E2E8F0" BorderThickness="0 0 0 1">
            <StackPanel Spacing="2">
                <TextBlock Text="AUDIO SETTINGS"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#6366F1"
                           LetterSpacing="2"/>
                <TextBlock Text="Driver, périphériques, sample rate et buffer"
                           FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" Padding="24 14"
                BorderBrush="#E2E8F0" BorderThickness="0 1 0 0">
            <Grid ColumnDefinitions="*, Auto, 8, Auto">
                <TextBlock Grid.Column="0"
                           Classes="status"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="secondary"
                        Content="Annuler"
                        Click="OnCancelClick"/>
                <Button Grid.Column="3"
                        Classes="primary"
                        Content="Appliquer"
                        Command="{Binding ApplyCommand}"
                        Click="OnApplyClick"/>
            </Grid>
        </Border>

        <!-- ── Content ─────────────────────────────────────────────────────── -->
        <ScrollViewer Padding="20 14">
            <StackPanel Spacing="0">

                <!-- ── Audio Driver ──────────────────────────────────────── -->
                <Border Classes="card">
                    <StackPanel Spacing="0">
                        <TextBlock Classes="section" Text="AUDIO DRIVER"/>
                        <TextBlock Classes="label" Text="Driver"/>
                        <ComboBox ItemsSource="{Binding AudioDrivers}"
                                  SelectedItem="{Binding SelectedAudioDriver}"/>
                    </StackPanel>
                </Border>

                <!-- ── WASAPI Devices (visible seulement si WASAPI) ──────── -->
                <Border Classes="card" IsVisible="{Binding IsWasapiSelected}">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="section" Text="PÉRIPHÉRIQUES WASAPI"/>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Entrée (Input Device)"/>
                            <Grid ColumnDefinitions="*, 8, Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding InputDevices}"
                                          SelectedItem="{Binding SelectedInputDevice}"/>
                                <Button Grid.Column="2"
                                        Classes="ghost"
                                        Content="&#8635;"
                                        FontSize="16"
                                        Command="{Binding RefreshDevicesCommand}"
                                        ToolTip.Tip="Rafraîchir la liste"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Sortie (Output Device)"/>
                            <ComboBox ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ASIO Driver (visible seulement si ASIO) ───────────── -->
                <Border Classes="card" IsVisible="{Binding IsAsioSelected}">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="section" Text="ASIO DRIVER"/>
                        <Grid ColumnDefinitions="*, 8, Auto, 8, Auto">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AsioDrivers}"
                                      SelectedItem="{Binding SelectedAsioDriver}"/>
                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Content="&#8635;"
                                    FontSize="16"
                                    Command="{Binding RefreshDevicesCommand}"
                                    ToolTip.Tip="Rafraîchir la liste"/>
                            <Button Grid.Column="4"
                                    Classes="secondary"
                                    Content="Control Panel"
                                    Command="{Binding OpenAsioControlPanelCommand}"
                                    ToolTip.Tip="Ouvrir le panneau de contrôle du driver ASIO"/>
                        </Grid>

                        <!-- ── Canaux ASIO ──────────────────────────────── -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Canal d'Entrée (décalage)"/>
                            <NumericUpDown Value="{Binding AsioInputOffset}"
                                           Minimum="0"
                                           Maximum="{Binding AsioMaxInputOffset}"
                                           Increment="1"
                                           FormatString="0"
                                           HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Canal de Sortie (décalage)"/>
                            <NumericUpDown Value="{Binding AsioOutputOffset}"
                                           Minimum="0"
                                           Maximum="{Binding AsioMaxOutputOffset}"
                                           Increment="1"
                                           FormatString="0"
                                           HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Sample Rate ────────────────────────────────────────── -->
                <Border Classes="card">
                    <StackPanel Spacing="0">
                        <TextBlock Classes="section" Text="FORMAT AUDIO"/>

                        <StackPanel Spacing="6" Margin="0 0 0 14">
                            <TextBlock Classes="label" Text="Sample Rate (Hz)"/>
                            <ComboBox ItemsSource="{Binding SampleRates}"
                                      SelectedItem="{Binding SelectedSampleRate}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Buffer Size (samples)"/>
                            <ComboBox ItemsSource="{Binding BufferSizes}"
                                      SelectedItem="{Binding SelectedBufferSize}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
